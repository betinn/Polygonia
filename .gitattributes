# Texto normalizado para LF no repositório e no checkout (evita avisos de CRLF no Windows).
* text=auto eol=lf
*.bat text eol=crlf

*.c text
*.cpp text
*.h text
*.hpp text
*.hlsl text
*.xml text

*.sln text eol=crlf
*.vcxproj text eol=crlf
*.vcxproj.filter text eol=crlf

*.sh text eol=lf
CMakeLists.txt text eol=lf

